{
  "name": "rejs",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "Plan, visualize, and compare longer journeys from a small DSL.",
  "license": "MIT",
  "homepage": "https://rejs.lillevang.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lillevang/rejs.git"
  },
  "bugs": {
    "url": "https://github.com/Lillevang/rejs/issues"
  },
  "keywords": [
    "journey-planner",
    "travel",
    "itinerary",
    "dsl",
    "map",
    "leaflet",
    "react",
    "vite",
    "local-first"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
